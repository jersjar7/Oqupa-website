VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
VITE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY_HERE
# Separate reCAPTCHA v3 site key registered as the App Check provider in
# Firebase console → App Check → Web app. Required for anonymous listing-view
# tracking and any other App-Check-enforced callables.
VITE_RECAPTCHA_APPCHECK_KEY=YOUR_RECAPTCHA_APPCHECK_SITE_KEY_HERE
# Optional: pin a stable App Check debug token for local dev so it does not
# rotate per session. Set only in .env.development, never in .env (production).
# Register the same value in Firebase console → App Check → Manage debug tokens.
# VITE_APPCHECK_DEBUG_TOKEN=00000000-0000-0000-0000-000000000000
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
