#!/bin/bash
#
# pre-push — Oqupa-website
#
# Pushing to development deploys staging; pushing to master deploys oqupa.com.
# A build that fails in CI on those branches means the site did not update, and
# nothing announces that except a pipeline nobody is watching.

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

protected_push=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  branch=${remote_ref#refs/heads/}
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ] &&
     { [ "$branch" = "master" ] || [ "$branch" = "development" ]; }; then
    echo "" >&2
    echo "BLOCKED: that would delete $branch on the remote." >&2
    echo "" >&2
    exit 1
  fi
  if [ "$branch" = "master" ] || [ "$branch" = "development" ]; then
    protected_push=1
  fi
done

[ "$protected_push" -eq 0 ] && exit 0

echo "pre-push: this pushes to a branch that deploys. Building first…"

if ! command -v npm > /dev/null 2>&1; then
  echo "  npm not on PATH — skipping. CI will still check." >&2
  exit 0
fi

# `npm run build` runs tsc then vite build — the same thing CI does.
if ! npm run build; then
  echo "" >&2
  echo "BLOCKED: the production build fails, so this push would not deploy." >&2
  echo "" >&2
  exit 1
fi

echo "pre-push: ok"
exit 0
